{
  "name": "aura-player",
  "private": true,
  "version": "5.0.0",
  "description": "Aura",
  "author": {
    "name": "ConsoleX",
    "email": "consolex@users.noreply.github.com"
  },
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc -b",
    "test": "tsx --tsconfig tsconfig.app.json --test scripts/*.test.ts",
    "test:frontend": "npm test",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "build:frontend": "npm run typecheck && vite build",
    "build": "npm run build:frontend",
    "tauri": "tauri",
    "dev:tauri": "npm run dev",
    "build:tauri": "tauri build",
    "release:windows": "npm ci && npm run typecheck && npm test && npm run check:rust && npm run test:rust && npx tauri build --bundles msi --bundles nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slider": "^1.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "tsx": "^4.20.6",
    "vite": "^8.1.0",
    "zustand": "^5.0.14"
  },
  "homepage": "https://github.com/ConsoleX-ir/Aura-player"
}
