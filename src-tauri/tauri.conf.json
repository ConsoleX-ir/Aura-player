{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Player",
  "version": "4.0.0-alpha.1",
  "identifier": "com.consolex.aura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aura",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0A0A0F",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: asset: http://asset.localhost aura-media: aura-media.localhost https: http:; media-src 'self' blob: aura-media: aura-media.localhost https: http:; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "copyright": "\u00a9 2026 ConsoleX",
    "shortDescription": "Local-first desktop music player",
    "longDescription": "Aura is a local-first desktop music player: your local library, online streaming through keyless providers, and a curated collection that ties both together.",
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 Audio",
        "description": "MP3 Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC Audio",
        "description": "FLAC Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV Audio",
        "description": "WAV Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogg"
        ],
        "name": "OGG Audio",
        "description": "OGG Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "M4A Audio",
        "description": "M4A Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "AAC Audio",
        "description": "AAC Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "Opus Audio",
        "description": "Opus Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "wma"
        ],
        "name": "WMA Audio",
        "description": "WMA Audio File",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": null
    }
  }
}